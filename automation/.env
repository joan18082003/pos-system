# =============================================
# CREDENCIALES PARA EL ENVÍO DE CORREOS
# =============================================
# SMTP (Gmail recomendado — usar App Password, NO la contraseña real)
# Guía para obtener un App Password de Gmail:
# https://support.google.com/accounts/answer/185833
# =============================================

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Tu correo Gmail desde donde se enviarán las notificaciones
SENDER_EMAIL=tu_correo@gmail.com

# Tu "Contraseña de Aplicación" de 16 dígitos de Google (NO tu contraseña normal)
SENDER_PASS=xxxx xxxx xxxx xxxx

# El correo del dueño donde recibirá las alertas
OWNER_EMAIL=dueno@gmail.com
